<Window x:Class="WpfApp_2026_11_02.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_2026_11_02"
        mc:Ignorable="d"
        Title="InfoWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Info" FontSize="32" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center"/>
            <TextBlock Text="Ez nem ablak page, hanem önálló window" FontSize="16" Margin="0,10,0,25" Foreground="#64748B" TextAlignment="Center"/>
            
            <TextBlock Text="Név" FontWeight="Bold"/>
            <TextBox x:Name="txtName" Height="40" FontSize="16" Padding="8" Margin="0,5,0,15"/>

            <Button Content="Köszönés" Height="45" Margin="0,0,0,10" Click="KoszonesClick"/>
            <Button Content="Ablak bezárása" Height="45" Click="BezarasClick"/>
        </StackPanel>
    </Grid>
</Window>
