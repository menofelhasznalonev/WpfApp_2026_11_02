<Page x:Class="WpfApp_2026_11_02.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp_2026_11_02"
      mc:Ignorable="d" 
      Background="Beige"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Profil" FontSize="32" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Ez egy másik page atrtalma" FontSize="16" Margin="0,10,0,25" Foreground="#64748B"/>
            <TextBlock Text="Név" FontWeight="Bold"/>
            <TextBox x:Name="txtName" Height="40" FontSize="16" Padding="8" Margin="0,5,0,15"/>
            <TextBlock Text="Email" FontWeight="Bold"/>
            <TextBox x:Name="emailName" Height="40" FontSize="16" Padding="8" Margin="0,5,0,20"/>
            <Button Content="Adatok ellenőrzése" Height="45" Margin="0,0,0,10"/>
            <Button Content="Vissza" Height="45" Click="BackClick"/>
        </StackPanel>


    </Grid>
</Page>
