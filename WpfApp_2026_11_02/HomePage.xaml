<Page x:Class="WpfApp_2026_11_02.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp_2026_11_02"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#F8FAFC"
      Title="HomePage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Főoldal" FontSize="32" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Ez a tartalom egy Page-ben található" FontSize="16" Foreground="#64748B" Margin="0,10,0,25"/>
            <Border Background="White" CornerRadius="15" Padding="25">
                <StackPanel>
                    <TextBlock Text="Page navigáció" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="A page nem nyit új ablakot. a Frame tartalmát cseréljük le" TextWrapping="Wrap" Margin="0,10,0,20"/>
                    <Button Content="Tovább a profil oldalára" Height="45" Click="GoToProfilClick"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
